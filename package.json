{
	"name": "@maple-dev/effect-orm",
	"version": "0.3.0",
	"description": "Type-safe ClickHouse and Postgres queries, result decoding, and reproducible benchmarks for Effect and TypeScript",
	"keywords": [
		"clickhouse",
		"effect",
		"orm",
		"postgres",
		"query-builder",
		"sql",
		"typescript"
	],
	"homepage": "https://effect-clickhouse.maple.dev",
	"bugs": {
		"url": "https://github.com/MapleTechLabs/effect-orm/issues"
	},
	"license": "MIT",
	"author": "Makisuo, Inc.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MapleTechLabs/effect-orm.git"
	},
	"bin": {
		"ch-bench": "./dist/benchmark/bin.mjs",
		"effect-orm": "./dist/kit/bin.mjs"
	},
	"files": [
		"dist",
		"docs",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./clickhouse": {
			"types": "./dist/clickhouse.d.mts",
			"import": "./dist/clickhouse.mjs"
		},
		"./expr": {
			"types": "./dist/expr.d.mts",
			"import": "./dist/expr.mjs"
		},
		"./sql": {
			"types": "./dist/sql.d.mts",
			"import": "./dist/sql.mjs"
		},
		"./postgres": {
			"types": "./dist/postgres.d.mts",
			"import": "./dist/postgres.mjs"
		},
		"./schema": {
			"types": "./dist/schema.d.mts",
			"import": "./dist/schema.mjs"
		},
		"./tinybird": {
			"types": "./dist/tinybird.d.mts",
			"import": "./dist/tinybird.mjs"
		},
		"./migrate": {
			"types": "./dist/migrate.d.mts",
			"import": "./dist/migrate.mjs"
		},
		"./database": {
			"types": "./dist/database.d.mts",
			"import": "./dist/database.mjs"
		},
		"./kit": {
			"types": "./dist/kit.d.mts",
			"import": "./dist/kit.mjs"
		},
		"./benchmark": {
			"types": "./dist/benchmark/index.d.mts",
			"import": "./dist/benchmark/index.mjs"
		},
		"./benchmark/http": {
			"types": "./dist/benchmark/http.d.mts",
			"import": "./dist/benchmark/http.mjs"
		},
		"./benchmark/cli": {
			"types": "./dist/benchmark/cli.d.mts",
			"import": "./dist/benchmark/cli.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
		"test": "vitest run && node scripts/check-doc-citations.mjs && node scripts/check-exports-documented.mjs && node scripts/check-doc-examples.mjs",
		"prepublishOnly": "bun run test:release",
		"test:clickhouse": "bun run build && bun scripts/test-clickhouse.ts",
		"test:package": "bun run build && bun scripts/check-package.ts",
		"test:release": "bun scripts/test-clickhouse.ts --release"
	},
	"devDependencies": {
		"@clickhouse/client": "1.21.0",
		"@effect/language-service": "^0.87.3",
		"@effect/platform-bun": "4.0.0",
		"@effect/sql-clickhouse": "4.0.0",
		"@effect/sql-pglite": "4.0.0",
		"@effect/vitest": "4.0.0",
		"@electric-sql/pglite": "0.5.8",
		"@types/node": "^22.10.2",
		"effect": "4.0.0",
		"expect-type": "^1.3.0",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.9"
	},
	"peerDependencies": {
		"effect": "^4.0.0"
	},
	"packageManager": "bun@1.4.0",
	"patchedDependencies": {
		"@effect/vitest@4.0.0": "patches/@effect%2Fvitest@4.0.0.patch"
	}
}
