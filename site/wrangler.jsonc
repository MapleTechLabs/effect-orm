{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "effect-orm-docs",
  // The Cloudflare account that owns the maple.dev zone.
  "account_id": "189f0e30f67d42ffb26513efbc104cf1",
  "compatibility_date": "2026-11-04",
  "routes": [{ "pattern": "effect-orm.maple.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
